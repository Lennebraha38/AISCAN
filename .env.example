# ---- Ortam ----
# development | test | production. Uretimde mutlaka "production" verin;
# aksi halde zayif varsayilan secret'lar tolere edilir.
PULSAR_ENV=development

# PostgreSQL
POSTGRES_DB=pulsar
POSTGRES_USER=pulsar
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://pulsar:change-me@postgres:5432/pulsar

# ---- Application security ----
# Uretimde (PULSAR_ENV=production) bu degerler ZORUNLU ve guclu olmalidir:
#   JWT_SECRET  : en az 32 karakter rastgele (openssl rand -hex 32)
#   ANON_SALT   : en az 16 karakter rastgele (pseudonym tuzu)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_DAYS=7
ANON_SALT=replace-with-a-random-anon-salt

# X-Forwarded-For yalnizca guvenilir ters proxy arkasinda 1 yapin
# (aksi halde audit IP'si spoof edilebilir).
TRUST_FORWARDED_FOR=0

# ---- Internal service connection ----
AI_CORE_URL=http://ai-core:8001
NEXT_PUBLIC_API_URL=http://localhost:8000
