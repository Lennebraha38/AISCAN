# PostgreSQL
POSTGRES_DB=pulsar
POSTGRES_USER=pulsar
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://pulsar:change-me@postgres:5432/pulsar

# Application security -- replace locally; never commit a real value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Internal service connection
AI_CORE_URL=http://ai-core:8001
NEXT_PUBLIC_API_URL=http://localhost:8000
